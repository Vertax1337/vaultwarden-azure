<?xml version="1.0" encoding="UTF-8"?>
<!--
  Vaultwarden on Azure Container Apps – Architecture Diagram (draw.io)

  Open this file with https://app.diagrams.net or the VS Code draw.io extension.
  To update the exported SVG, use File → Export as → SVG and save as
  docs/diagrams/vaultwarden-aca-architecture.svg.

  Tip: For official Azure service icons, import the Azure icon set via
  File → Open Library → Azure in draw.io, then replace the placeholder
  shapes below with the matching Azure service icons.
-->
<mxfile host="app.diagrams.net" agent="manual" version="24.7">
  <diagram id="vw-aca-arch" name="Baseline Architecture">
    <mxGraphModel dx="1400" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Resource Group boundary -->
        <mxCell id="rg" value="Resource Group" style="rounded=1;whiteSpace=wrap;dashed=1;dashPattern=8 4;strokeColor=#0078D4;fillColor=none;fontColor=#0078D4;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="50" width="1000" height="520" as="geometry"/>
        </mxCell>

        <!-- Container Apps Environment -->
        <mxCell id="cae" value="Container Apps Environment" style="rounded=1;whiteSpace=wrap;fillColor=#E8F4FD;strokeColor=#0078D4;fontColor=#0078D4;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="400" height="160" as="geometry"/>
        </mxCell>

        <!-- Container App (Vaultwarden) -->
        <mxCell id="ca" value="Azure Container App&#xa;Vaultwarden (Docker image)&#xa;Ingress · HTTPS · /data mount&#xa;ENV from Key Vault secret refs" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.2;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="125" width="360" height="105" as="geometry"/>
        </mxCell>

        <!-- Log Analytics -->
        <mxCell id="la" value="Log Analytics&#xa;Workspace" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="90" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- CAE → Log Analytics -->
        <mxCell id="e_cae_la" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0078D4;" edge="1" source="cae" target="la" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Azure Files -->
        <mxCell id="af" value="Azure Files&#xa;Storage Account&#xa;File Share → /data" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- Container App → Azure Files -->
        <mxCell id="e_ca_af" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0078D4;" edge="1" source="ca" target="af" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- PostgreSQL -->
        <mxCell id="pg" value="PostgreSQL Flexible Server&#xa;Azure Database for PostgreSQL&#xa;DATABASE_URL via Key Vault" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="310" y="290" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- Container App → PostgreSQL -->
        <mxCell id="e_ca_pg" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0078D4;" edge="1" source="ca" target="pg" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Key Vault -->
        <mxCell id="kv" value="Azure Key Vault&#xa;RBAC · Secrets&#xa;DB URL, SMTP, SSO, Push" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="580" y="290" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- Container App → Key Vault -->
        <mxCell id="e_ca_kv" value="secret refs" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0078D4;fontSize=10;fontColor=#0078D4;" edge="1" source="ca" target="kv" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Managed Identities -->
        <mxCell id="mi" value="Managed Identities&#xa;App Identity (Secrets User)&#xa;KV Writer Identity (Secrets Officer)" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="830" y="90" width="180" height="80" as="geometry"/>
        </mxCell>

        <!-- Managed Identities → Key Vault -->
        <mxCell id="e_mi_kv" value="RBAC" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0078D4;fontSize=10;fontColor=#0078D4;" edge="1" source="mi" target="kv" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Deployment Script -->
        <mxCell id="ds" value="Deployment Script&#xa;Bootstrap: DB user,&#xa;secrets → Key Vault" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="580" y="405" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- Deployment Script → Key Vault -->
        <mxCell id="e_ds_kv" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0078D4;" edge="1" source="ds" target="kv" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Deployment Script → PostgreSQL -->
        <mxCell id="e_ds_pg" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0078D4;" edge="1" source="ds" target="pg" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Recovery Services Vault -->
        <mxCell id="rsv" value="Recovery Services Vault&#xa;Azure Files Backup&#xa;Daily + Weekly retention" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="405" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- Recovery Services → Azure Files -->
        <mxCell id="e_rsv_af" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0078D4;" edge="1" source="rsv" target="af" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Diagnostic Settings -->
        <mxCell id="diag" value="Diagnostic Settings&#xa;Key Vault → Log Analytics&#xa;PostgreSQL → Log Analytics" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="310" y="405" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- Diagnostic Settings → Log Analytics -->
        <mxCell id="e_diag_la" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0078D4;" edge="1" source="diag" target="la" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== Optional: ACS Foundation ===== -->
        <mxCell id="acs_box" value="Optional – ACS Foundation (acsDeployFoundation = true)" style="rounded=1;whiteSpace=wrap;dashed=1;dashPattern=6 3;strokeColor=#E6A800;fillColor=#FFF8E1;fontColor=#E6A800;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="585" width="700" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="acs_email" value="Email Service&#xa;ACS Email Service" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E6A800;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="620" width="190" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="acs_domain" value="Email Domain Resource&#xa;Custom domain (DNS verification)" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E6A800;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="290" y="620" width="210" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="acs_comm" value="Communication Service&#xa;ACS Communication Service" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E6A800;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="620" width="220" height="55" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
