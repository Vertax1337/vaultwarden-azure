{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "mainTemplateUri": {
      "type": "string",
      "defaultValue": "https://raw.githubusercontent.com/Vertax1337/vaultwarden-azure/master/main.json",
      "metadata": {
        "description": "Remote URI of the main ARM template. Adjust this when using a fork or another branch."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources"
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "prod",
      "allowedValues": [
        "prod",
        "test",
        "dev"
      ],
      "metadata": {
        "description": "Kosten/Zuordnung: Umgebung (prod/test/dev)"
      }
    },
    "edgeMode": {
      "type": "string",
      "defaultValue": "none",
      "allowedValues": [
        "none",
        "cloudflare-managed"
      ],
      "metadata": {
        "description": "Deployment mode for edge hardening. none = Azure-only/basic, cloudflare-managed = production path with post-deploy Cloudflare automation."
      }
    },
    "enableIngressIpRestrictions": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "If true, apply ACA ingress IP restrictions using ingressAllowedCidrs. Intended for the Cloudflare-managed production path."
      }
    },
    "ingressAllowedCidrs": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Allowed CIDR ranges for ACA ingress when enableIngressIpRestrictions=true. Example: Cloudflare edge IP ranges."
      }
    },
    "customHostname": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional customer-facing hostname (for example vault.example.com). Used by the production wrapper/documentation. The ARM deployment itself does not bind the hostname."
      }
    },
    "bsseRef": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Traceability: BSSE Deploy-Ref (z.B. Git Tag oder Commit SHA)"
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "vault",
      "maxLength": 10,
      "metadata": {
        "description": "Name of the Vaultwarden Container App"
      }
    },
    "vaultwardenImage": {
      "type": "string",
      "defaultValue": "vaultwarden/server:1.35.3-alpine",
      "metadata": {
        "description": "Container image to use for Vaultwarden (pin a version for reproducible deployments)"
      }
    },
    "cpuCores": {
      "type": "string",
      "defaultValue": "0.25",
      "metadata": {
        "description": "CPU cores for the container"
      }
    },
    "memorySize": {
      "type": "string",
      "defaultValue": "0.5",
      "metadata": {
        "description": "Memory in GiB for the container (CPU:RAM ratio must be 1:2)"
      }
    },
    "allowInsecureHttp": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Allow insecure HTTP traffic (recommended: false for production)"
      }
    },
    "diagnosticsEnabled": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable Azure Monitor diagnostic settings for Key Vault and PostgreSQL Flexible Server (Log Analytics)."
      }
    },
    "deploymentScriptForceUpdateTag": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional forceUpdateTag for the bootstrap deploymentScript. Change this value to force a controlled rerun without changing app settings."
      }
    },
    "domainUrl": {
      "type": "string",
      "minLength": 9,
      "metadata": {
        "description": "Public URL of your Vaultwarden instance. MUST include https:// (example: https://sub.domain.tld)"
      }
    },
    "adminPanelEnabled": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Vaultwarden ADMIN_TOKEN als App-ENV setzen. Default true fuer Erstdeployment/Bootstrap/Tests. Fuer den produktiven Steady State nach erfolgreichem Setup auf false setzen, damit ADMIN_TOKEN nicht mehr an die App durchgereicht wird. Achtung: Falls admin_token bereits in /data/config.json persistiert wurde, dort ebenfalls entfernen, sonst bleibt das Admin-Panel aktiv."
      }
    },
    "invitationOrgName": {
      "type": "string",
      "defaultValue": "Vaultwarden",
      "metadata": {
        "description": "Vaultwarden ENV: INVITATION_ORG_NAME. Organization name shown in invitation mails."
      }
    },
    "signupsDomainsWhitelist": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Vaultwarden ENV: SIGNUPS_DOMAINS_WHITELIST. Comma-separated email domains allowed to self-register."
      }
    },
    "orgCreationUsers": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Vaultwarden ENV: ORG_CREATION_USERS. Optional comma-separated user emails allowed to create organizations. Empty = all users."
      }
    },
    "mailRootDomain": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Explizite Root-Domain für Mailrouting und Default-Absender (z. B. example.com). Verwende diesen Parameter für Direct Send ohne expliziten smtpHost, für ACS Foundation ohne explizites acsDomainName und für den automatischen Default-Absender, wenn smtpFrom leer bleibt. Keine Ableitung mehr aus domainUrl."
      }
    },
    "smtpUseAuth": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Wenn true, nutzt Vaultwarden SMTP Submission mit Auth (empfohlener Produktiv-Default). Wenn false, wird Direct Send ohne Auth verwendet. Wichtig für Vaultwarden: In diesem Modus werden SMTP_USERNAME, SMTP_PASSWORD und SMTP_AUTH_MECHANISM nicht an die App durchgereicht; bereits im Vaultwarden-Adminbereich gespeicherte SMTP-Auth-Werte in /data/config.json müssen bei einem Moduswechsel ggf. separat bereinigt werden."
      }
    },
    "smtpFrom": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "SMTP FROM address (z. B. vaultwarden@domain.tld). Für Produktion explizit setzen."
      }
    },
    "smtpFromName": {
      "type": "string",
      "defaultValue": "Vaultwarden",
      "metadata": {
        "description": "Anzeigename im From-Header."
      }
    },
    "heloName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Vaultwarden ENV: HELO_NAME. Empty = derive host name from DOMAIN / domainUrl."
      }
    },
    "smtpHost": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optionaler SMTP Host Override. Leer = SMTP Auth: smtp.office365.com; Direct Send: MX-Lookup ausschließlich auf mailRootDomain. Für den aktuellen Direct-Send-Pfad setzt das Template in der App SMTP_PORT=25 und SMTP_SECURITY=starttls und lässt SMTP_USERNAME / SMTP_PASSWORD / SMTP_AUTH_MECHANISM weg."
      }
    },
    "smtpPort": {
      "type": "string",
      "defaultValue": "587",
      "metadata": {
        "description": "SMTP port (M365 default: 587)"
      }
    },
    "smtpSecurity": {
      "type": "string",
      "defaultValue": "starttls",
      "allowedValues": [
        "starttls",
        "force_tls",
        "off"
      ],
      "metadata": {
        "description": "SMTP security (starttls / force_tls / off)"
      }
    },
    "smtpUsername": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "SMTP username (often same as smtpFrom)"
      }
    },
    "smtpPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "SMTP password"
      }
    },
    "smtpAuthMechanism": {
      "type": "string",
      "defaultValue": "",
      "allowedValues": [
        "",
        "Plain",
        "Login",
        "Xoauth2",
        "Plain,Login",
        "Login,Plain"
      ],
      "metadata": {
        "description": "Optional (nur SMTP Auth): SMTP Auth Mechanism. Mögliche Werte u.a.: Plain, Login, Xoauth2 (auch kommasepariert)."
      }
    },
    "ssoEnabled": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable Vaultwarden SSO (OIDC) for Web Vault login (requires Vaultwarden >= 1.35)."
      }
    },
    "ssoOnly": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "If true, only SSO login is allowed (no email/password). Use with care."
      }
    },
    "ssoAuthority": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "OIDC authority/issuer base URL. For Entra ID use https://login.microsoftonline.com/<TENANT_ID>/v2.0 and do not append /.well-known/openid-configuration."
      }
    },
    "ssoClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "OIDC Client ID / Application (client) ID."
      }
    },
    "ssoClientSecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "OIDC Client Secret / App secret value."
      }
    },
    "ssoScopes": {
      "type": "string",
      "defaultValue": "openid profile email offline_access User.Read",
      "metadata": {
        "description": "OIDC scopes passed to Vaultwarden. For Entra ID the default openid profile email offline_access User.Read is recommended."
      }
    },
    "pushEnabled": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable mobile push notifications (requires Bitwarden push relay credentials)."
      }
    },
    "pushInstallationId": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Bitwarden push installation id (from https://bitwarden.com/host/). Treated as secret and stored in Key Vault."
      }
    },
    "pushInstallationKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Bitwarden push installation key (from https://bitwarden.com/host/). Treated as secret and stored in Key Vault."
      }
    },
    "pushUseEuServers": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Use Bitwarden EU push relay / identity endpoints. Select this only when the Installation ID / Key were requested for the EU region."
      }
    },
    "acsDeployFoundation": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Optional: deploy Azure Communication Services foundation resources (Email Service, Email Domain resource, Communication Service) together with the core stack. Domain verification, domain linking and SMTP username activation remain manual post-deploy steps."
      }
    },
    "acsDataLocation": {
      "type": "string",
      "defaultValue": "Germany",
      "metadata": {
        "description": "ACS data location for Email Service and Communication Service, e.g. Germany, Europe or UnitedStates. Email Service and Communication Service must use the same geography."
      }
    },
    "acsDomainName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Custom domain to prepare in ACS Email, e.g. example.com. Leer = verwende mailRootDomain. Es gibt keine automatische Ableitung mehr aus domainUrl."
      }
    },
    "storageAccountSku": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": [
        "Standard_LRS",
        "Standard_ZRS",
        "Standard_GRS",
        "Standard_RAGRS",
        "Standard_GZRS",
        "Standard_RAGZRS"
      ],
      "metadata": {
        "description": "Storage account SKU for Azure Files"
      }
    },
    "azureFilesBackupEnabled": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable Azure Backup for the Azure File Share used by Vaultwarden (/data)."
      }
    },
    "azureFilesBackupScheduleRunTime": {
      "type": "string",
      "defaultValue": "05:30",
      "metadata": {
        "description": "Time of day (HH:MM) when backup should run. MM must be 00 or 30."
      }
    },
    "azureFilesBackupTimeZone": {
      "type": "string",
      "defaultValue": "UTC",
      "metadata": {
        "description": "Windows timezone name for the backup schedule, e.g. UTC, W. Europe Standard Time."
      }
    },
    "azureFilesBackupDailyRetentionDays": {
      "type": "int",
      "defaultValue": 30,
      "metadata": {
        "description": "Number of days to retain daily Azure Files backups."
      }
    },
    "azureFilesBackupWeeklyDaysOfWeek": {
      "type": "array",
      "defaultValue": [
        "Sunday",
        "Tuesday",
        "Thursday"
      ],
      "metadata": {
        "description": "Days of week used for weekly retention points."
      }
    },
    "azureFilesBackupWeeklyRetentionWeeks": {
      "type": "int",
      "defaultValue": 12,
      "metadata": {
        "description": "Number of weeks to retain weekly Azure Files backups."
      }
    },
    "postgresSkuName": {
      "type": "string",
      "defaultValue": "Standard_B1ms",
      "metadata": {
        "description": "PostgreSQL SKU name"
      }
    },
    "postgresVersion": {
      "type": "string",
      "defaultValue": "16",
      "allowedValues": [
        "15",
        "16",
        "17"
      ],
      "metadata": {
        "description": "PostgreSQL major version. New deployments should use the latest supported version. Existing servers cannot be downgraded."
      }
    },
    "postgresStorageGB": {
      "type": "int",
      "defaultValue": 32,
      "metadata": {
        "description": "PostgreSQL storage size in GB"
      }
    },
    "postgresBackupRetentionDays": {
      "type": "int",
      "defaultValue": 14,
      "minValue": 7,
      "maxValue": 35,
      "metadata": {
        "description": "Point-in-time restore retention in Tagen für PostgreSQL Flexible Server."
      }
    },
    "allowAzureServicesToPostgres": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Allow Azure services to access PostgreSQL (0.0.0.0 firewall rule). Recommended: true for Container Apps without VNet/NAT."
      }
    },
    "dbAdminUser": {
      "type": "string",
      "defaultValue": "vaultwarden",
      "metadata": {
        "description": "Azure PostgreSQL Flexible Server administrator login. Required for server creation and initial bootstrap only; not used by the Vaultwarden app itself."
      }
    },
    "dbPassword": {
      "type": "securestring",
      "defaultValue": "[concat(toUpper(newGuid()), newGuid())]",
      "metadata": {
        "description": "Azure PostgreSQL Flexible Server administrator password. Required for server creation and initial bootstrap only; not stored in Key Vault and not used as Vaultwarden app credential."
      }
    },
    "hibpApiKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "HIBP (Have I Been Pwned) API key. Stored in Key Vault. Leave empty to use placeholder '00000-00000-00000'."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "vaultwardenMainTemplate",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[parameters('mainTemplateUri')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "environment": {
            "value": "[parameters('environment')]"
          },
          "edgeMode": {
            "value": "[parameters('edgeMode')]"
          },
          "enableIngressIpRestrictions": {
            "value": "[parameters('enableIngressIpRestrictions')]"
          },
          "ingressAllowedCidrs": {
            "value": "[parameters('ingressAllowedCidrs')]"
          },
          "customHostname": {
            "value": "[parameters('customHostname')]"
          },
          "bsseRef": {
            "value": "[parameters('bsseRef')]"
          },
          "appName": {
            "value": "[parameters('appName')]"
          },
          "vaultwardenImage": {
            "value": "[parameters('vaultwardenImage')]"
          },
          "cpuCores": {
            "value": "[parameters('cpuCores')]"
          },
          "memorySize": {
            "value": "[parameters('memorySize')]"
          },
          "allowInsecureHttp": {
            "value": "[parameters('allowInsecureHttp')]"
          },
          "diagnosticsEnabled": {
            "value": "[parameters('diagnosticsEnabled')]"
          },
          "deploymentScriptForceUpdateTag": {
            "value": "[parameters('deploymentScriptForceUpdateTag')]"
          },
          "domainUrl": {
            "value": "[parameters('domainUrl')]"
          },
          "adminPanelEnabled": {
            "value": "[parameters('adminPanelEnabled')]"
          },
          "invitationOrgName": {
            "value": "[parameters('invitationOrgName')]"
          },
          "signupsDomainsWhitelist": {
            "value": "[parameters('signupsDomainsWhitelist')]"
          },
          "orgCreationUsers": {
            "value": "[parameters('orgCreationUsers')]"
          },
          "mailRootDomain": {
            "value": "[parameters('mailRootDomain')]"
          },
          "smtpUseAuth": {
            "value": "[parameters('smtpUseAuth')]"
          },
          "smtpFrom": {
            "value": "[parameters('smtpFrom')]"
          },
          "smtpFromName": {
            "value": "[parameters('smtpFromName')]"
          },
          "heloName": {
            "value": "[parameters('heloName')]"
          },
          "smtpHost": {
            "value": "[parameters('smtpHost')]"
          },
          "smtpPort": {
            "value": "[parameters('smtpPort')]"
          },
          "smtpSecurity": {
            "value": "[parameters('smtpSecurity')]"
          },
          "smtpUsername": {
            "value": "[parameters('smtpUsername')]"
          },
          "smtpPassword": {
            "value": "[parameters('smtpPassword')]"
          },
          "smtpAuthMechanism": {
            "value": "[parameters('smtpAuthMechanism')]"
          },
          "ssoEnabled": {
            "value": "[parameters('ssoEnabled')]"
          },
          "ssoOnly": {
            "value": "[parameters('ssoOnly')]"
          },
          "ssoAuthority": {
            "value": "[parameters('ssoAuthority')]"
          },
          "ssoClientId": {
            "value": "[parameters('ssoClientId')]"
          },
          "ssoClientSecret": {
            "value": "[parameters('ssoClientSecret')]"
          },
          "ssoScopes": {
            "value": "[parameters('ssoScopes')]"
          },
          "pushEnabled": {
            "value": "[parameters('pushEnabled')]"
          },
          "pushInstallationId": {
            "value": "[parameters('pushInstallationId')]"
          },
          "pushInstallationKey": {
            "value": "[parameters('pushInstallationKey')]"
          },
          "pushUseEuServers": {
            "value": "[parameters('pushUseEuServers')]"
          },
          "acsDeployFoundation": {
            "value": "[parameters('acsDeployFoundation')]"
          },
          "acsDataLocation": {
            "value": "[parameters('acsDataLocation')]"
          },
          "acsDomainName": {
            "value": "[parameters('acsDomainName')]"
          },
          "storageAccountSku": {
            "value": "[parameters('storageAccountSku')]"
          },
          "azureFilesBackupEnabled": {
            "value": "[parameters('azureFilesBackupEnabled')]"
          },
          "azureFilesBackupScheduleRunTime": {
            "value": "[parameters('azureFilesBackupScheduleRunTime')]"
          },
          "azureFilesBackupTimeZone": {
            "value": "[parameters('azureFilesBackupTimeZone')]"
          },
          "azureFilesBackupDailyRetentionDays": {
            "value": "[parameters('azureFilesBackupDailyRetentionDays')]"
          },
          "azureFilesBackupWeeklyDaysOfWeek": {
            "value": "[parameters('azureFilesBackupWeeklyDaysOfWeek')]"
          },
          "azureFilesBackupWeeklyRetentionWeeks": {
            "value": "[parameters('azureFilesBackupWeeklyRetentionWeeks')]"
          },
          "postgresVersion": {
            "value": "[parameters('postgresVersion')]"
          },
          "postgresSkuName": {
            "value": "[parameters('postgresSkuName')]"
          },
          "postgresStorageGB": {
            "value": "[parameters('postgresStorageGB')]"
          },
          "postgresBackupRetentionDays": {
            "value": "[parameters('postgresBackupRetentionDays')]"
          },
          "allowAzureServicesToPostgres": {
            "value": "[parameters('allowAzureServicesToPostgres')]"
          },
          "dbAdminUser": {
            "value": "[parameters('dbAdminUser')]"
          },
          "dbPassword": {
            "value": "[parameters('dbPassword')]"
          },
          "hibpApiKey": {
            "value": "[parameters('hibpApiKey')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "nestedDeploymentName": {
      "type": "string",
      "value": "[resourceId('Microsoft.Resources/deployments', 'vaultwardenMainTemplate')]"
    }
  }
}
