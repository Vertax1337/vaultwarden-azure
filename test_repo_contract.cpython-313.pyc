{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "domainUrl": {
      "value": "https://vault.example.de"
    },
    "mailRootDomain": {
      "value": "example.de"
    },
    "smtpUseAuth": {
      "value": false
    },
    "smtpFrom": {
      "value": "vaultwarden@example.de"
    },
    "smtpFromName": {
      "value": "Vaultwarden"
    },
    "smtpHost": {
      "value": "example-de.mail.protection.outlook.com"
    }
  }
}
